{
  "name": "cordel",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev": "docker compose up -d && pnpm --parallel -r run dev",
    "dev:local": "node scripts/start-redis.mjs && pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @cordel/web run dev",
    "dev:api": "docker compose up -d && pnpm --filter @cordel/api run dev",
    "dev:api:local": "node scripts/start-redis.mjs && pnpm --filter @cordel/api run dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
