generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "postgresql"
}

model User {
    id              String   @id @default(cuid())
    email           String   @unique
    name            String
    plan            Plan     @default(FREE)
    emailVerifiedAt DateTime?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
}

enum Plan {
    FREE
    PREMIUM
    }

model Organization {
    id        String   @id @default(cuid())
    name      String
    slug      String   @unique
    ownerId   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
